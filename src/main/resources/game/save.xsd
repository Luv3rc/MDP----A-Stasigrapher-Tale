<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema of a save file (format version 2). It says where the player is in the story and how every member of the
  party is, with what he wields and what he knows. The weapon and the abilities are written by id, like in members.xml.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="idType">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="memberType">
    <xs:sequence>
      <xs:element name="points">
        <xs:complexType>
          <xs:attribute name="health" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="strength" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="defense" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="agility" type="xs:nonNegativeInteger" use="required"/>
          <xs:attribute name="luck" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="abilities">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="learn" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType><xs:attribute name="ref" type="idType" use="required"/></xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="idType" use="required"/>
    <xs:attribute name="level" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="xp" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="hp" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="unspentPoints" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="weapon" type="idType" use="required"/>
  </xs:complexType>

  <xs:element name="save">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="position">
          <xs:complexType>
            <xs:attribute name="step" type="idType" use="required"/>
            <xs:attribute name="trekProgress" type="xs:nonNegativeInteger" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="party">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="member" type="memberType" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>

    <xs:key name="memberKey">
      <xs:selector xpath="party/member"/><xs:field xpath="@id"/>
    </xs:key>
  </xs:element>

</xs:schema>
